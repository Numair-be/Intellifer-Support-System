# Host ports. Only the host side changes; containers talk to each other on fixed internal ports.
# deploy.sh checks which ports are already taken on the server and picks free ones, writing them here.
HUB_API_PORT=8080
HUB_DB_PORT=5432
OPENWA_PORT=8081
# The API listens on this host address. 127.0.0.1 = only this server (put a reverse proxy in front for outside access).
HUB_API_BIND=127.0.0.1

POSTGRES_USER=intellifer
POSTGRES_PASSWORD=intellifer
POSTGRES_DB=intellifer_hub

# Local defaults. Replace these before connecting a real mailbox or WhatsApp number.
HUB_API_KEY=dev-only-change-me
OPENWA_WEBHOOK_SECRET=dev-only-openwa-secret
# Admin key of the WhatsApp gateway (OpenWA by rmyndharis). At least 32 characters: it refuses shorter ones.
WA_API_KEY=dev-only-openwa-api-key
# Name of the hub's session in the gateway (created automatically).
WA_SESSION_NAME=support
# Number that POST /api/whatsapp/link sends a pairing code to: country code first, digits only.
# Leave empty to link with a QR code instead.
WA_LINK_PHONE=
DEFAULT_PHONE_REGION=IN

# Leave blank until the consent tool has produced a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCOUNT=
GMAIL_MAILBOX=me
GMAIL_POLL_INTERVAL_SECONDS=45
GMAIL_BOOTSTRAP_DAYS=7
GMAIL_BOOTSTRAP_MAX_MESSAGES=50
GMAIL_PROCESSED_LABEL=Support

# Odoo customer lookup (read-only). Leave ODOO_URL empty to turn it off.
# From inside Docker, an Odoo running on this PC is http://host.docker.internal:8069, not localhost.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
# An API key from Odoo: Preferences -> Account Security -> New API Key. A password also works.
ODOO_API_KEY=

# Plane intake (self-hosted). Bug and error messages from WhatsApp and email open an intake item;
# later messages in the same conversation are added to it as comments. Leave PLANE_URL empty to turn it off.
PLANE_URL=
# Profile settings -> Personal access tokens (or Workspace settings -> API tokens).
PLANE_API_KEY=
# The part after the domain in Plane's URL: https://plane.example.com/<workspace-slug>/projects/...
PLANE_WORKSPACE_SLUG=
# Routing: a message from an Odoo client contact goes to the Plane project whose name or identifier
# matches the contact's Odoo client project name or code (case, spaces and punctuation ignored).
# New Plane projects are picked up within 5 minutes. GET /api/plane/check shows every link.
# Optional: the project of intake items created before per-project routing, so their comments still land.
PLANE_PROJECT_ID=
# Optional: links for names that differ, "Odoo project=Plane name or identifier", comma-separated.
# PLANE_PROJECT_MAP=Larsen Valves Pvt=LNT,Prana=PRANALABS
# Optional. Comma-separated words or phrases that mark a message as a bug or error. Setting it REPLACES
# the built-in list (bug, error, not working, crash, failed, fix, ...), so include the ones you still want.
# PLANE_INTAKE_KEYWORDS=bug,error,not working,crash,failed

# Status replies: when a Plane intake item changes status (accepted, backlog, to do, in progress, done,
# cancelled, declined, duplicate) the customer gets a reply on the channel they used: a reply in the same
# Gmail thread, or a WhatsApp message in the same chat. Items are checked every PLANE_STATUS_POLL_MINUTES.
PLANE_STATUS_REPLIES=true
# Reply with the ticket number (e.g. PLANE-10) as soon as an intake item is created.
PLANE_ACKNOWLEDGE_INTAKE=true
PLANE_STATUS_POLL_MINUTES=2
REPLY_SIGNATURE=Intellifer Support

# Images sent by email or WhatsApp are attached to the Plane ticket. Larger images are skipped (with the reason
# kept); Plane's own upload limit (FILE_SIZE_LIMIT on the Plane server) defaults to 5 MB.
PLANE_ATTACHMENT_MAX_MB=5

# A new ticket waits until the conversation has been quiet this long, then all the messages are judged
# together: bug or error wording anywhere opens ONE ticket with every message and image; otherwise all are
# skipped. Messages after a ticket exists become comments straight away.
PLANE_WHATSAPP_QUIET_SECONDS=120
PLANE_EMAIL_QUIET_SECONDS=0
# A chat that already has a ticket gets a NEW ticket for its next report when that ticket is closed
# (done, cancelled, declined, duplicate) or nothing was added to it for this many hours.
PLANE_NEW_TICKET_AFTER_IDLE_HOURS=24

# Tell the employees on the client project when an intake item is created for it ("New intake for project X:
# PLANE-12 ... kindly update it as soon as possible", with a link). Needs the Odoo employee lookup, which is not
# connected yet: until it is, nothing is sent. PLANE_TEAM_CHANNELS: whatsapp (email when no phone), email, or both.
PLANE_NOTIFY_TEAM=true
PLANE_TEAM_CHANNELS=whatsapp

# Errors from apps on the server: POST /api/errors with the app's key (create apps with POST /api/apps).
# Dates in ticket titles use this time zone. The same error from an app within APP_ERROR_REPEAT_MINUTES is counted,
# not ticketed again; each app opens at most APP_ERROR_MAX_TICKETS_PER_HOUR tickets an hour.
HUB_TIME_ZONE=Asia/Kolkata
APP_ERROR_REPEAT_MINUTES=60
APP_ERROR_MAX_TICKETS_PER_HOUR=30
